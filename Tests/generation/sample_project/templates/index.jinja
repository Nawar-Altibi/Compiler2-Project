{% extends "base.html" %}
{% block title %}{{ title }}{% endblock %}
{% block content %}
<h2>{{ title }} ({{ products|length }} products)</h2>
<div class="product-grid">
{% for product in products %}
<div class="product-card">
<h3>{{ loop.index }}. {{ product.name }}</h3>
<p>{{ product.description }}</p>
<p class="price">${{ product.price }}</p>
{% if product.price > 500 %}
<span class="premium">Premium</span>
{% endif %}
<div class="product-actions">
<a href="{{ url_for('edit_product') }}" data-edit-product="{{ product.id }}">Edit</a>
<button type="button" class="danger" data-delete-product="{{ product.id }}" data-product-name="{{ product.name }}">Delete</button>
</div>
</div>
{% endfor %}
</div>
{% endblock %}
